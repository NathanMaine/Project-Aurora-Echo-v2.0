# =============================================================================
# Aurora Echo Demo — P50 / OpenRouter Configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Then set your OpenRouter API key below.

# --- OpenRouter LLM ---------------------------------------------------------
# Get your key at https://openrouter.ai/keys
LLM_PROVIDER_ORDER=openai
OPENAI_API_KEY=sk-or-v1-paste-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_ID=meta-llama/llama-3.1-8b-instruct

# --- ASR (Speech-to-Text) ---------------------------------------------------
# "small" = ~1GB VRAM, "medium" = ~2.5GB, "large-v2" = ~4GB
# For a 4GB GPU, "small" is the safe choice
WHISPER_MODEL_SIZE=small

# --- Optional ----------------------------------------------------------------
# Speaker diarization (who said what) — get token at huggingface.co/settings/tokens
# HF_TOKEN=hf_your-token-here

# Disable text-to-speech for demo
ENABLE_TTS=0

# Logging
LOG_LEVEL=INFO
