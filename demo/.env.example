# =============================================================================
# Aurora Echo Demo — Environment Configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Then set your LLM API key below (OpenRouter, OpenAI, Anthropic, etc.)
# See demo/README.md for all provider options.

# --- OpenRouter LLM ---------------------------------------------------------
# Get your key at https://openrouter.ai/keys
LLM_PROVIDER_ORDER=openai
OPENAI_API_KEY=sk-or-v1-paste-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_ID=meta-llama/llama-3.1-8b-instruct

# --- ASR (Speech-to-Text) ---------------------------------------------------
# "small" = ~1GB VRAM, "medium" = ~2.5GB, "large-v2" = ~4GB
# Pick based on your GPU: no GPU → tiny/base, 2-4GB → small, 8GB+ → large-v2
WHISPER_MODEL_SIZE=small

# --- Optional ----------------------------------------------------------------
# Speaker diarization (who said what) — get token at huggingface.co/settings/tokens
# HF_TOKEN=hf_your-token-here

# Disable text-to-speech for demo
ENABLE_TTS=0

# Logging
LOG_LEVEL=INFO
