# Copy sensitive values from a secure secret store before running docker compose
# Triton Inference Server with vLLM backend
VLLM_BASE_URL=http://triton:8000/v1
VLLM_MODEL_ID=llama
VLLM_COMPLETIONS_ENDPOINT=/chat/completions
LLM_PROVIDER_ORDER=vllm,grok
INFERENCE_WORKERS=2
INFERENCE_BATCH_SIZE=1
ORCHESTRATOR_BACKEND=docker
AUDIO_ENCRYPTION_KEY=
